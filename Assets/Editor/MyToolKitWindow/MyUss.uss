#ToolbarButton {
    color: rgb(255, 95, 95);
    flex-wrap: nowrap;
    justify-content: center;
    align-items: auto;
    -unity-font-style: bold;
}

.PropField {
    margin-top: 0;
    background-color: rgba(230, 255, 1, 0.12);
    padding-top: 4px;
    padding-bottom: 4px;
    padding-right: 4px;
    padding-left: 4px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-left-color: rgb(19, 99, 69);
    border-right-color: rgb(19, 99, 69);
    border-top-color: rgb(19, 99, 69);
    border-bottom-color: rgb(19, 99, 69);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}
